{
  "require":
  {
    "rizwanjiwan/commonpub":"dev-main",
    "openai-php/client": "0.19.*",
    "fastvolt/markdown": "0.2.*",
    "ext-pdo": "*",
    "ext-curl": "*",
    "ext-iconv": "*"
  },
  "autoload": {
    "psr-4": {
      "rizwanjiwan\\commonai\\": "src/rizwanjiwan/commonai"
    }
  },
  "repositories": [
    {
      "type": "vcs",
      "url":  "git@github.com:rizwanjiwan/commonpub.git"
    }
  ],
  "name": "rizwanjiwan/commonai",
  "description": "Common OpenAI client utilities.",
  "config": {
    "platform": {
      "php": "8.3.0"
    },
    "allow-plugins": {
      "php-http/discovery": true,
      "tbachert/spi": true
    }
  }
}
